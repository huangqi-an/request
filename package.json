{
  "name": "@huangqi_an/request",
  "version": "0.3.0",
  "description": "统一请求层：零依赖 core + 按需导入的 adapter 插件（fetch / axios / uni-app）",
  "type": "module",
  "license": "MIT",
  "author": "huangqi-an <94596499+huangqi-an@users.noreply.github.com>",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./adapters/fetch": {
      "types": "./dist/adapters/fetch.d.ts",
      "import": "./dist/adapters/fetch.js"
    },
    "./adapters/axios": {
      "types": "./dist/adapters/axios.d.ts",
      "import": "./dist/adapters/axios.js"
    },
    "./adapters/uniapp": {
      "types": "./dist/adapters/uniapp.d.ts",
      "import": "./dist/adapters/uniapp.js"
    },
    "./interceptors": {
      "types": "./dist/interceptors/index.d.ts",
      "import": "./dist/interceptors/index.js"
    },
    "./interceptors/auth": {
      "types": "./dist/interceptors/auth.d.ts",
      "import": "./dist/interceptors/auth.js"
    },
    "./interceptors/request-id": {
      "types": "./dist/interceptors/request-id.d.ts",
      "import": "./dist/interceptors/request-id.js"
    },
    "./interceptors/unwrap": {
      "types": "./dist/interceptors/unwrap.d.ts",
      "import": "./dist/interceptors/unwrap.js"
    },
    "./interceptors/logger": {
      "types": "./dist/interceptors/logger.d.ts",
      "import": "./dist/interceptors/logger.js"
    },
    "./enhancers/retry": {
      "types": "./dist/enhancers/retry.d.ts",
      "import": "./dist/enhancers/retry.js"
    },
    "./enhancers/dedupe": {
      "types": "./dist/enhancers/dedupe.d.ts",
      "import": "./dist/enhancers/dedupe.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "axios": "^1.7.0"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "axios": "^1.7.0",
    "tsup": "^9.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huangqi-an/request.git"
  },
  "keywords": [
    "request",
    "http",
    "axios",
    "fetch",
    "uni-app",
    "uniapp",
    "miniprogram",
    "adapter",
    "interceptor"
  ]
}
